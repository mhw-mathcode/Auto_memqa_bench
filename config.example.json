{
  "pipeline": {
    "input_dir": "dataset",
    "runs_dir": "runs",
    "max_workers": 4,
    "run_targets": [],
    "batch_max_workers": 1,
    "version_prefix": "v"
  },
  "steps": {
    "step_0_generate_qa": {
      "function": "generate_qa_v0",
      "api_required": true,
      "description": "步骤 0: 生成原始问答对",
      "skip": false,
      "force_generate_new_qa": false,
      "speaker_batch_size": 1,
      "max_workers": 4,
      "llm": {
        "model": "qwen3-14b",
        "base_url": "https://api.example.com/v1",
        "api_key": "YOUR_API_KEY_HERE"
      }
    },
    "step_1_refine_qa": {
      "function": "new_qa_main",
      "api_required": true,
      "description": "步骤 1: 问题精炼与重构 (v0 -> v1_refined)",
      "skip": false,
      "max_workers": 4,
      "llm": {
        "model": "qwen3-14b",
        "base_url": "https://api.example.com/v1",
        "api_key": "YOUR_API_KEY_HERE"
      }
    },
    "step_2_evidence_check": {
      "function": "evidence_check_main",
      "api_required": true,
      "description": "步骤 2: 题目合理性检测 (v1_refined -> v2a -> v2b)",
      "skip": false,
      "mode": "full",
      "max_workers": 4,
      "only_evidence_max_workers": 4,
      "iterative_ablation_max_workers": 3,
      "ablation_context_limit": 32768,
      "ablation_prompt_safety_tokens": 4096,
      "ablation_chunk_tokens": 8192,
      "ablation_retrieval_chunks": 6,
      "ablation_chunk_max_workers": 4,
      "llm": {
        "model": "qwen3-14b",
        "base_url": "https://api.example.com/v1",
        "api_key": "YOUR_API_KEY_HERE"
      }
    },
    "step_3_pollution_check": {
      "function": "pollution_check_main",
      "api_required": true,
      "description": "步骤 3: 污染检查 (v2b -> v3)",
      "skip": false,
      "enable_contamination_check": true,
      "cleanup_temp_files": true,
      "max_workers": 4,
      "llm": {
        "model": "qwen3-14b",
        "base_url": "https://api.example.com/v1",
        "api_key": "YOUR_API_KEY_HERE"
      }
    },
    "step_4_finalize": {
      "function": "finalize_main",
      "api_required": false,
      "description": "步骤 4: 生成最终版本 (v3 -> final)",
      "skip": false,
      "max_workers": 4
    }
  }
}
